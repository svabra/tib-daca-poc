DIDACA_CONTROL_DATABASE_URL=postgresql+psycopg://didaca_control:replace-me@postgres:5432/didaca_control_plane
DIDACA_CONTROL_ENVIRONMENT=development
DIDACA_CONTROL_CORS_ORIGINS=http://localhost:8081
DIDACA_CONTROL_HEALTH_POLL_INTERVAL_SECONDS=30
DIDACA_CONTROL_HEALTH_REQUEST_TIMEOUT_SECONDS=3
DIDACA_CONTROL_POLICY_SYNC_ENABLED=false
DIDACA_CONTROL_SEED_ON_STARTUP=false

DACA_CONTROL_DATABASE_URL=postgresql+psycopg://daca_control:replace-me@postgres:5432/daca_control_plane
DACA_CONTROL_ENVIRONMENT=development
DACA_CONTROL_CORS_ORIGINS=http://localhost:8081
DACA_CONTROL_HEALTH_POLL_INTERVAL_SECONDS=30
DACA_CONTROL_HEALTH_REQUEST_TIMEOUT_SECONDS=3
DACA_CONTROL_POLICY_SYNC_ENABLED=false
DACA_CONTROL_SEED_ON_STARTUP=false
DACA_CONTROL_DEMO_AUTH=true
DACA_CONTROL_ENDPOINT_HOST_ALLOWLIST=catalog-api

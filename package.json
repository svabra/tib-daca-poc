{
  "name": "bit-didaca",
  "version": "0.1.0",
  "private": true,
  "description": "BIT Distributed Data Catalog proof of concept",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:python",
    "build:web": "npm run build --workspaces --if-present",
    "build:python": "uv build --all-packages --out-dir dist/python",
    "test": "npm run test:web && npm run test:python && npm run test:opa",
    "test:web": "npm run test --workspaces --if-present",
    "test:python": "uv run --all-packages pytest",
    "test:opa": "node scripts/test-opa.mjs",
    "lint": "npm run lint:web && npm run lint:python",
    "lint:web": "npm run lint --workspaces --if-present",
    "lint:python": "uv run --all-packages ruff check services",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "start:catalog-ui": "npm run start --workspace @didaca/catalog-ui",
    "start:control-plane-ui": "npm run start --workspace @didaca/control-plane-ui"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0"
  }
}

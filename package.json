{
  "name": "bit-daca",
  "version": "0.1.17",
  "private": true,
  "description": "BIT Distributed Data Catalog proof of concept",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:python",
    "build:web": "npm run build --workspaces --if-present && npm run version:check-build",
    "build:python": "uv build --all-packages --out-dir dist/python",
    "test": "npm run test:web && npm run test:python && npm run test:opa && npm run docs:data-model:check && npm run docs:openapi:check",
    "test:web": "npm run test --workspaces --if-present",
    "test:python": "uv run --all-packages pytest",
    "test:opa": "node scripts/test-opa.mjs",
    "docs:data-model": "uv run python scripts/render_data_model.py",
    "docs:data-model:check": "uv run python scripts/render_data_model.py --check",
    "docs:openapi": "uv run python scripts/render_metadata_publication_openapi.py",
    "docs:openapi:check": "uv run python scripts/render_metadata_publication_openapi.py --check",
    "version:check": "uv run python scripts/versioning.py check",
    "version:check-build": "uv run python scripts/versioning.py check-build",
    "version:bump": "uv run python scripts/versioning.py bump",
    "lint": "npm run lint:web && npm run lint:python",
    "lint:web": "npm run lint --workspaces --if-present",
    "lint:python": "uv run --all-packages ruff check services journeys",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "journey:data-analyst": "uv run --package daca-journey-runner daca-journey data-analyst-golden-path",
    "journey:data-analyst:headed": "uv run --package daca-journey-runner daca-journey data-analyst-golden-path --headed",
    "start:catalog-ui": "npm run start --workspace @daca/catalog-ui",
    "start:control-plane-ui": "npm run start --workspace @daca/control-plane-ui"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0"
  }
}

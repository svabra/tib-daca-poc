{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "appData": {
    "schemaVersion": 1,
    "appId": "catalog-ui",
    "releaseVersion": "0.1.22"
  },
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/styles-*.css",
          "/main-*.js",
          "/manifest.webmanifest",
          "/assets/**",
          "!/assets/swiss-*-*.avif",
          "!/assets/swiss-*-*.webp"
        ]
      }
    },
    {
      "name": "decorative-media",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/assets/swiss-*-*.avif",
          "/assets/swiss-*-*.webp"
        ]
      }
    },
    {
      "name": "lazy-features",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/chunk-*.js"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/api/**"
  ]
}
